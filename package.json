{
  "name": "papoosh-automations",
  "version": "1.2.1",
  "private": true,
  "description": "PAPOOSH Automations - Personal Automation Command Center & Mobile Hub for Tal Fradkin",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/bump-version.js && vite build",
    "preview": "vite preview --host",
    "report": "node agent/papoosh-cli.js",
    "run-all": "node agent/run-automations.js",
    "bridge": "node agent/papoosh-bridge.js",
    "import-downloads": "node agent/auto-import-downloads.js",
    "claude": "node agent/ask-claude.js",
    "release": "node scripts/bump-version.js --patch && vite build"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11"
  }
}
